# EDUNEXIS - Environment Configuration Template
# Copy this file to .env and fill in values as needed. NEVER commit .env to version control.

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Backend Server Configuration
BACKEND_PORT=8000

# Database Connection (Placeholder - database is not yet provisioned)
DATABASE_URL=

# AI & LLM Service Configuration
LLM_API_KEY=
LLM_MODEL=

# Machine Translation API (Member 3 - Translation Module)
# Optional: The module works out-of-the-box with Google Translate & offline fallback.
# Provide an API key here if integrating custom Bhashini / Cloud translation service.
TRANSLATION_API_KEY=

# Speech Processing APIs (STT / TTS)
SPEECH_API_KEY=

# Frontend Application URL (for CORS allowance)
FRONTEND_URL=http://localhost:5173
